Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04

# AlphaFold 3, translated from docker/Dockerfile in google-deepmind/alphafold3.
#
# Why a translation rather than `singularity build ... docker-daemon://`:
# the upstream instructions require building the Docker image first, then
# pushing it to a local registry and converting. Beta has no Docker and no root,
# so the Dockerfile is reproduced here directly.
#
# Two Dockerfile features have no Singularity equivalent and are worked around:
#
#   COPY --from=ghcr.io/astral-sh/uv:0.9.24  -- a multi-stage copy from another
#   image. Replaced with uv's standalone installer, pinned to the same version.
#
#   RUN --mount=type=cache,target=/root/.cache/uv  -- a BuildKit cache mount.
#   Purely a build-speed optimisation; dropped.
#
# Everything else, including the HMMER 3.4 build with the jackhmmer sequence
# limit patch, follows upstream exactly.
#
# Build (needs the alphafold3 source tree as the build context):
#     cd third_party/af3_code
#     singularity build --fakeroot /tmp/af3/alphafold3.sif ../af3.def
#
# If --fakeroot is unavailable, `singularity build --remote` uses the Sylabs
# cloud builder instead, which needs an account and an access token.

%files
    . /app/alphafold

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    apt-get update --quiet
    apt-get install --yes --quiet python3.12 python3.12-dev
    apt-get install --yes --quiet git wget curl gcc g++ make zlib1g-dev zstd \
        ca-certificates patch
    rm -rf /var/lib/apt/lists/*

    # uv, pinned to the version the Dockerfile copies from ghcr.io
    export UV_INSTALL_DIR=/bin
    curl -LsSf https://astral.sh/uv/0.9.24/install.sh | sh
    /bin/uv --version

    export UV_COMPILE_BYTECODE=1
    export UV_PROJECT_ENVIRONMENT=/alphafold3_venv
    /bin/uv venv $UV_PROJECT_ENVIRONMENT
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"

    # ---- HMMER 3.4, built from source with the sequence-limit patch ----
    # Built rather than apt-installed so the version is pinned and the patch
    # applies. eddylab.org does not serve HTTPS; the hash check below is the
    # integrity guarantee, and is the same one upstream uses.
    mkdir -p /hmmer_build /hmmer
    wget http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz \
        --directory-prefix /hmmer_build
    cd /hmmer_build
    echo "ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3  hmmer-3.4.tar.gz" \
        | sha256sum --check
    tar zxf hmmer-3.4.tar.gz
    rm hmmer-3.4.tar.gz

    cp /app/alphafold/docker/jackhmmer_seq_limit.patch /hmmer_build/
    patch -p0 < jackhmmer_seq_limit.patch

    cd /hmmer_build/hmmer-3.4
    ./configure --prefix /hmmer
    make -j"$(nproc)"
    make install
    cd /hmmer_build/hmmer-3.4/easel && make install
    rm -rf /hmmer_build

    # ---- AlphaFold 3 itself ----
    cd /app/alphafold
    UV_LINK_MODE=copy /bin/uv sync --frozen --all-groups --no-editable

    # chemical components database, built by a binary uv sync installs
    /bin/uv run build_data

%environment
    export UV_PROJECT_ENVIRONMENT=/alphafold3_venv
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"

    # Works around an XLA issue that otherwise inflates compilation time.
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"

    # Upstream defaults target an A100 80 GB. For a 24 GB card the docs
    # recommend disabling preallocation and enabling unified memory, which lets
    # inputs up to ~1,024 tokens run on cards as small as a V100 16 GB. Our
    # pMHC complexes are 383 tokens.
    export XLA_PYTHON_CLIENT_PREALLOCATE=false
    export TF_FORCE_UNIFIED_MEMORY=true
    export XLA_CLIENT_MEM_FRACTION=3.2

%runscript
    cd /app/alphafold
    exec /bin/uv run python3 run_alphafold.py "$@"

%labels
    Description AlphaFold 3, Singularity translation of the upstream Dockerfile
    Upstream https://github.com/google-deepmind/alphafold3

%help
    Run with --nv, and pass --flash_attention_implementation=xla on any GPU
    that is not an A100 or H100: the Triton flash-attention kernel supports
    only those.

    Model parameters are not included and must be obtained separately, subject
    to the AlphaFold 3 weights terms of use. Output may not be used to train
    models intended for commercial application.

    Example, using pre-computed MSAs so that the ~630 GB genetic databases are
    not required:

        singularity run --nv \
            --bind $PWD/af_input:/root/af_input \
            --bind $PWD/af_output:/root/af_output \
            --bind $PWD/af_models:/root/models \
            alphafold3.sif \
            --json_path=/root/af_input/fold_input.json \
            --model_dir=/root/models \
            --output_dir=/root/af_output \
            --flash_attention_implementation=xla \
            --norun_data_pipeline
